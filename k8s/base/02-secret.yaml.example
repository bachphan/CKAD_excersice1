# File mẫu — KHÔNG chứa secret thật.
# Copy thành 02-secret.yaml, thay giá trị bên dưới bằng giá trị tự sinh, rồi mới `kubectl apply`.
# File 02-secret.yaml thật đã được thêm vào .gitignore, không commit lên git.
#
# Cách sinh giá trị ngẫu nhiên an toàn:
#   openssl rand -hex 24   # cho JWT_SECRET
#   openssl rand -hex 16   # cho INTERNAL_API_KEY và POSTGRES_PASSWORD
apiVersion: v1
kind: Secret
metadata:
  name: babymilk-secret
  namespace: babymilk
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_ME_WITH_RANDOM_HEX"
  INTERNAL_API_KEY: "REPLACE_ME_WITH_RANDOM_HEX"
  ADMIN_PASSWORD: "REPLACE_ME_WITH_STRONG_PASSWORD"
  POSTGRES_PASSWORD: "REPLACE_ME_WITH_RANDOM_HEX"
