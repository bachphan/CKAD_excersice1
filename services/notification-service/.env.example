# notification-service — copy thành .env cho local dev. Trên K8s các biến này đến từ ConfigMap/Secret.
PORT=4004
# Kết nối PostgreSQL — tên biến chuẩn của node-postgres (Pool tự đọc, không cần code thêm)
PGHOST=localhost
PGPORT=5432
PGDATABASE=babymilk_notifications
PGUSER=babymilk
PGPASSWORD=dev-postgres-password
# Phải GIỐNG NHAU ở cả 3 backend service dùng JWT (product/user/order không cần notification xác
# thực người dùng khác, nhưng route admin GET /api/notifications cần verify JWT admin)
JWT_SECRET=dev-jwt-secret-change-me
# Redis Pub/Sub — order-service publish "order.completed", notification-service subscribe
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL=order.completed
