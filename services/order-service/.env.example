# order-service — copy thành .env cho local dev. Trên K8s các biến này đến từ ConfigMap/Secret.
PORT=4003
# Kết nối PostgreSQL — tên biến chuẩn của node-postgres (Pool tự đọc, không cần code thêm)
PGHOST=localhost
PGPORT=5432
PGDATABASE=babymilk_orders
PGUSER=babymilk
PGPASSWORD=dev-postgres-password
# Phải GIỐNG NHAU ở cả 3 backend service
JWT_SECRET=dev-jwt-secret-change-me
# Địa chỉ product-service (trên K8s sẽ là http://product-service:4001)
PRODUCT_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_TIMEOUT_MS=5000
# Khóa gọi API nội bộ của product-service — phải giống bên product-service
INTERNAL_API_KEY=dev-internal-key-change-me
# Redis Pub/Sub — publish "order.completed" sau checkout, notification-service subscribe
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL=order.completed
