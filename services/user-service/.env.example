# user-service — copy thành .env cho local dev. Trên K8s các biến này đến từ ConfigMap/Secret.
PORT=4002
DB_PATH=./data/users.db
# Phải GIỐNG NHAU ở cả 3 backend service
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=24h
# Tài khoản admin được tạo tự động lần đầu khởi động (bỏ trống để tắt)
ADMIN_EMAIL=admin@babymilk.local
ADMIN_PASSWORD=admin12345
