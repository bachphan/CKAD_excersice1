# product-service — copy thành .env cho local dev. Trên K8s các biến này đến từ ConfigMap/Secret.
PORT=4001
DB_PATH=./data/products.db
# Phải GIỐNG NHAU ở cả 3 backend service (dùng để verify JWT do user-service phát hành)
JWT_SECRET=dev-jwt-secret-change-me
# Khóa cho API nội bộ /internal/* (order-service gọi sang) — phải giống bên order-service
INTERNAL_API_KEY=dev-internal-key-change-me
# Tự nạp dữ liệu mẫu khi DB rỗng
SEED_ON_START=true
